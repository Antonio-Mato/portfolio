{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "public/**",
      "firebase-debug.log",
      "assets/*.png",
      "assets/*.jpg",
      "index.backup.html",
      "build.py",
      "index.presprite.html",
      "site-prompt.md",
      "site-prompt-exact.md"
    ],
    "headers": [
      {
        "source": "**/*.@(mp4|webm|webp|jpg|jpeg|png|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}